# ===========================================================================
#  RAG — From Fundamentals to Production
#  Lab repository: what must NOT be committed.
#
#  Every corpus, fixture and sample document is generated locally by the
#  generate_*.py script of its chapter. Nothing here is a source file:
#  running the generator rebuilds all of it, deterministically.
# ===========================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Corpora and fixtures generated by generate_*.py ---
corpus/
data/
fixtures/
sample_docs/
attachments/
cache/

# --- Artefacts produced by running the labs ---
*.png
*.html
*.npy
*.eml
demo_citations.html
demo_stream.html

# Generated office documents and PDFs (ch08, ch09, ch10)
*.docx
*.pptx
*.xlsx
*.pdf

# --- Editors and operating systems ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ===========================================================================
#  Exceptions: files that ARE sources and must stay under version control.
# ===========================================================================
!requirements.txt
!requirements-all.txt
!ch17-advanced-chunking/corrections.csv
